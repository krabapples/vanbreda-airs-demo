# --- Prisma AIRS AI Gateway ---------------------------------------------
# Base URL of the OpenAI-compatible endpoint exposed by the AI Gateway.
# The agent calls <AI_GATEWAY_ENDPOINT>/chat/completions
AI_GATEWAY_ENDPOINT=https://your-gateway.example.com/v1

# API key for the gateway
AI_GATEWAY_API_KEY=changeme

# Model to request, as configured behind the gateway.
# Portkey-style gateways take "@<provider-slug>/<model>", e.g. @vertex/gemini-2.5-flash-lite
AI_GATEWAY_MODEL=gpt-4o-mini

# How the API key is sent. Default: "Authorization: Bearer <key>".
# Set to e.g. "x-pan-token" to send "x-pan-token: <key>" instead.
AI_GATEWAY_AUTH_HEADER=Authorization

# Optional extra headers sent on every gateway request (JSON object).
# Example for a Portkey-style gateway: {"x-portkey-provider":"@your-slug"}
AI_GATEWAY_EXTRA_HEADERS=

# --- Optional -------------------------------------------------------------
AI_GATEWAY_TIMEOUT=60
# Set to false for lab gateways with self-signed certificates
VERIFY_TLS=true
# Host port for the web UI
HOST_PORT=18080
